# Copy this file to `.env` and fill in the keys for the providers you intend to use.
# Keys are loaded at runtime only. They are never printed and never written to metadata.

# --- Provider credentials ---
OPENAI_API_KEY=
FAL_KEY=
REPLICATE_API_TOKEN=
# Google Gemini — powers Nano Banana / Nano Banana Pro. Either name works.
GEMINI_API_KEY=
# GOOGLE_API_KEY=

# --- Optional defaults (sensible values are used if these are omitted) ---
# PORTRAIT_DEFAULT_PROVIDER=mock
# PORTRAIT_DEFAULT_MODEL=mock-image
# PORTRAIT_OUTPUT_BASE_DIR=./outputs
# PORTRAIT_ALLOW_CUSTOM_BUCKETS=false
# Path to a JSON model/pricing registry. If unset, the bundled default is used.
# PORTRAIT_MODEL_REGISTRY_PATH=./app/core/model_registry.json
# OpenAI-compatible base URL override (e.g. for Azure/proxies)
# OPENAI_BASE_URL=https://api.openai.com/v1
